# ─────────────────────────────────────────────────────────────────────
# AgriSense AI — environment template
# Copy to `.env` at the repo root and fill in. NEVER commit the real .env.
# ─────────────────────────────────────────────────────────────────────

# ── LLM (agent reasoning loop). Primary provider: OpenAI (§1.8 override — see CLAUDE.md) ──
OPENAI_API_KEY=
LLM_MODEL=gpt-4o
# Optional failover provider (see config/llm.ts)
ANTHROPIC_API_KEY=

# ── Embeddings (RAG). OpenAI text-embedding-3-small → 1536-d (matches migration) ──
EMBEDDING_MODEL=text-embedding-3-small

# ── Database: Supabase Postgres + pgvector ──
# Supabase → Project Settings → Database → Connection string → URI
DATABASE_URL=
# Optional (supabase-js / storage). DATABASE_URL alone is enough for the models layer.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Weather: Open-Meteo (keyless — no key needed; here for documentation) ──
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# ── bdapps CaaS (payment). `simulated` = local simulator (default, sanctioned by the brief) ──
# Flip to `live` only with provisioned credentials; bdapps whitelists by IP (E1303).
CAAS_MODE=simulated
BDAPPS_BASE_URL=https://developer.bdapps.com
BDAPPS_APPLICATION_ID=
BDAPPS_PASSWORD=

# ── API server ──
PORT=4000
NODE_ENV=development

# ── Web → API (used by Next.js rewrites proxy + client) ──
NEXT_PUBLIC_API_URL=http://localhost:4000
